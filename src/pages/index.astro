---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import LibrarySidebar from '../components/LibrarySidebar.astro';
import AppListItem from '../components/AppListItem.astro';
import { getApps, type AppWithTech } from '../lib/db';
import { getCurrentUser, isAdmin } from '../lib/auth';
import {
  APP_CATEGORIES,
  APP_STATUSES,
  isAppCategory,
  isAppStatus,
  type AppCategory,
  type AppStatus,
} from '../lib/catalog';

const user = await getCurrentUser(Astro.request, env.JWT_SECRET);
const admin = isAdmin(user, env.ADMIN_GITHUB_USERNAME);
Astro.response.headers.set('Cache-Control', 'private, no-store');

let allApps: AppWithTech[] = [];
try {
  allApps = await getApps(env.DB, user?.userId);
} catch {
  // DB not initialized yet - show empty state
}

const categoryParam = Astro.url.searchParams.get('category');
const statusParam = Astro.url.searchParams.get('status');
const activeCategory: AppCategory | 'all' = isAppCategory(categoryParam) ? categoryParam : 'all';
const activeStatus: AppStatus | 'all' = isAppStatus(statusParam) ? statusParam : 'all';

const categoryCounts = Object.fromEntries(
  Object.keys(APP_CATEGORIES).map((key) => [key, allApps.filter((app) => app.category === key).length])
) as Record<AppCategory, number>;
const statusCounts = Object.fromEntries(
  Object.keys(APP_STATUSES).map((key) => [key, allApps.filter((app) => app.status === key).length])
) as Record<AppStatus, number>;

const filteredApps = allApps.filter((app) =>
  (activeCategory === 'all' || app.category === activeCategory) &&
  (activeStatus === 'all' || app.status === activeStatus)
);

const groups = Object.entries(APP_CATEGORIES)
  .map(([key, category]) => ({
    key: key as AppCategory,
    category,
    apps: filteredApps.filter((app) => app.category === key),
  }))
  .filter((group) => group.apps.length > 0);

const pageTitle = activeCategory !== 'all'
  ? APP_CATEGORIES[activeCategory].label
  : activeStatus !== 'all'
    ? APP_STATUSES[activeStatus].label
    : 'すべてのアプリ';
const pageDescription = activeCategory !== 'all'
  ? APP_CATEGORIES[activeCategory].description
  : activeStatus !== 'all'
    ? APP_STATUSES[activeStatus].description
    : 'つくったプロダクトと、その技術構成をひとつの場所で。';
---
<Layout title={`${pageTitle} - App Library`}>
  <div class="min-h-screen lg:flex bg-slate-100">
    <LibrarySidebar
      user={user}
      active="apps"
      activeCategory={activeCategory}
      activeStatus={activeStatus}
      totalApps={allApps.length}
      categoryCounts={categoryCounts}
      statusCounts={statusCounts}
    />

    <div class="min-w-0 flex-1">
      <header class="library-topbar">
        <div class="relative min-w-0 flex-1 max-w-xl">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke-width="2" /><path stroke-linecap="round" stroke-width="2" d="m20 20-4-4" />
          </svg>
          <input id="app-search" type="search" class="library-search-input" placeholder="アプリ、目的、技術で検索…" autocomplete="off" />
        </div>
        <span id="visible-count" class="hidden sm:block text-xs text-slate-500 whitespace-nowrap">{filteredApps.length} apps</span>
        {admin && (
          <div class="flex items-center gap-2">
            <button id="edit-mode-btn" class="secondary-button">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.9 3.6 3.5 3.5M19 2a2.1 2.1 0 0 1 3 3L8 19l-5 1 1-5L19 2z" /></svg>
              <span class="hidden sm:inline">編集</span>
            </button>
            <button id="add-app-btn" class="primary-button">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M12 5v14M5 12h14" /></svg>
              <span class="hidden sm:inline">アプリを追加</span>
            </button>
          </div>
        )}
      </header>

      <main class="px-4 sm:px-6 lg:px-10 py-7 lg:py-10 max-w-[1500px] mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-8">
          <div>
            <p class="eyebrow mb-2">Apps / {activeCategory !== 'all' ? APP_CATEGORIES[activeCategory].shortLabel : 'Library'}</p>
            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-slate-950">{pageTitle}</h1>
            <p class="mt-2 text-sm text-slate-500">{pageDescription}</p>
          </div>
          <div class="flex items-center gap-2">
            <label class="sr-only" for="mobile-category">カテゴリー</label>
            <select id="mobile-category" class="filter-select lg:hidden">
              <option value="/" selected={activeCategory === 'all'}>すべてのカテゴリー</option>
              {Object.entries(APP_CATEGORIES).map(([key, category]) => (
                <option value={`/?category=${key}`} selected={activeCategory === key}>{category.label}</option>
              ))}
            </select>
            <label class="sr-only" for="status-filter">ステータス</label>
            <select id="status-filter" class="filter-select">
              <option value="all" selected={activeStatus === 'all'}>すべての状態</option>
              {Object.entries(APP_STATUSES).map(([key, item]) => <option value={key} selected={activeStatus === key}>{item.label}</option>)}
            </select>
            <span class="view-mode-indicator" title="リスト表示">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" /></svg>
            </span>
          </div>
        </div>

        {groups.length > 0 ? (
          <div id="app-list-root" class="space-y-8">
            {groups.map((group) => (
              <section class="app-category-section" data-group={group.key}>
                <div class="flex items-center gap-3 mb-3 px-1">
                  <span class:list={['category-accent', `category-accent-${group.category.accent}`]}></span>
                  <h2 class="text-sm font-semibold text-slate-800">{group.category.label}</h2>
                  <span class="text-xs text-slate-400">{group.apps.length}</span>
                  <span class="hidden sm:block text-xs text-slate-400 ml-1">{group.category.description}</span>
                </div>
                <div class="app-list">
                  {group.apps.map((app) => <AppListItem app={app} admin={admin} />)}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="empty-library">
            <span class="empty-library-icon">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 7.5A2.5 2.5 0 016.5 5h11A2.5 2.5 0 0120 7.5v9a2.5 2.5 0 01-2.5 2.5h-11A2.5 2.5 0 014 16.5v-9zM8 5V3m8 2V3" /></svg>
            </span>
            <h2>このカテゴリーにはまだアプリがありません</h2>
            <p>{admin ? '「アプリを追加」から最初のアプリを登録できます。' : '新しいアプリを準備中です。'}</p>
          </div>
        )}
        <div id="search-empty" class="empty-library hidden">
          <h2>一致するアプリがありません</h2>
          <p>別の名前、目的、技術名で検索してください。</p>
        </div>
      </main>
    </div>
  </div>

  {admin && <div id="dialog-root"></div>}
</Layout>

<script>
  const searchInput = document.getElementById('app-search') as HTMLInputElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const mobileCategory = document.getElementById('mobile-category') as HTMLSelectElement | null;
  const visibleCount = document.getElementById('visible-count');
  const searchEmpty = document.getElementById('search-empty');

  function filterApps() {
    const query = searchInput?.value.trim().toLowerCase() || '';
    const status = statusFilter?.value || 'all';
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.app-list-item').forEach((item) => {
      const matchesQuery = !query || (item.dataset.search || '').includes(query);
      const matchesStatus = status === 'all' || item.dataset.status === status;
      item.classList.toggle('hidden', !(matchesQuery && matchesStatus));
      if (matchesQuery && matchesStatus) visible += 1;
    });
    document.querySelectorAll<HTMLElement>('.app-category-section').forEach((section) => {
      const hasVisibleApps = Array.from(section.querySelectorAll<HTMLElement>('.app-list-item'))
        .some((item) => !item.classList.contains('hidden'));
      section.classList.toggle('hidden', !hasVisibleApps);
    });
    if (visibleCount) visibleCount.textContent = `${visible} apps`;
    searchEmpty?.classList.toggle('hidden', visible > 0);
  }

  searchInput?.addEventListener('input', filterApps);
  statusFilter?.addEventListener('change', filterApps);
  mobileCategory?.addEventListener('change', () => { location.href = mobileCategory.value; });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const expandButton = target.closest('.app-expand-btn') as HTMLButtonElement | null;
    if (!expandButton) return;
    const article = expandButton.closest('.app-list-item');
    const panel = article?.querySelector<HTMLElement>('.app-details-panel');
    if (!article || !panel) return;
    const willOpen = panel.classList.contains('hidden');
    document.querySelectorAll<HTMLElement>('.app-details-panel').forEach((item) => item.classList.add('hidden'));
    document.querySelectorAll<HTMLButtonElement>('.app-expand-btn').forEach((button) => button.setAttribute('aria-expanded', 'false'));
    if (willOpen) {
      panel.classList.remove('hidden');
      article.querySelectorAll<HTMLButtonElement>('.app-expand-btn').forEach((button) => button.setAttribute('aria-expanded', 'true'));
    }
  });
</script>

{admin && (
  <script>
    const editModeBtn = document.getElementById('edit-mode-btn');
    let editMode = false;
    editModeBtn?.addEventListener('click', () => {
      editMode = !editMode;
      document.body.classList.toggle('edit-mode', editMode);
      document.querySelectorAll('.edit-mode-ui').forEach((element) => element.classList.toggle('hidden', !editMode));
      editModeBtn.classList.toggle('is-active', editMode);
    });

    document.addEventListener('click', async (event) => {
      const deleteButton = (event.target as HTMLElement).closest('.delete-btn') as HTMLElement | null;
      if (!deleteButton) return;
      const appId = deleteButton.dataset.deleteAppId;
      if (!appId || !confirm('本当に削除しますか？')) return;
      const response = await fetch(`/api/apps?id=${appId}`, { method: 'DELETE' });
      if (response.ok) location.reload();
      else alert('削除に失敗しました');
    });

    const listRoot = document.getElementById('app-list-root');
    let draggedItem: HTMLElement | null = null;
    listRoot?.addEventListener('mousedown', (event) => {
      const handle = (event.target as HTMLElement).closest('.drag-handle');
      if (!handle || !editMode) return;
      const item = handle.closest('article') as HTMLElement | null;
      if (item) item.draggable = true;
    });
    listRoot?.addEventListener('dragstart', (event) => {
      const item = (event.target as HTMLElement).closest('article') as HTMLElement | null;
      if (!item || !editMode) return;
      draggedItem = item;
      item.classList.add('is-dragging');
    });
    listRoot?.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (!draggedItem) return;
      const target = (event.target as HTMLElement).closest('article') as HTMLElement | null;
      if (!target || target === draggedItem || target.parentElement !== draggedItem.parentElement) return;
      const bounds = target.getBoundingClientRect();
      target[ event.clientY > bounds.top + bounds.height / 2 ? 'after' : 'before' ](draggedItem);
    });
    listRoot?.addEventListener('dragend', async () => {
      if (!draggedItem) return;
      draggedItem.classList.remove('is-dragging');
      draggedItem.draggable = false;
      const orders = Array.from(listRoot.querySelectorAll<HTMLElement>('article')).map((item, index) => ({
        id: Number(item.dataset.appId), display_order: index,
      }));
      draggedItem = null;
      await fetch('/api/apps/reorder', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orders }),
      });
    });
  </script>
)}

{admin && (
  <script>
    import { render, h } from 'preact';
    import AddAppDialog from '../components/AddAppDialog';
    import type { AppCategory, AppStatus } from '../lib/catalog';

    const addButton = document.getElementById('add-app-btn');
    const dialogRoot = document.getElementById('dialog-root');
    interface EditAppData {
      id: number; title: string; description: string; site_url: string; github_url: string;
      thumbnail_url: string; thumbnail_type: string; is_private: boolean;
      category: AppCategory; status: AppStatus; tech_ids: number[];
    }
    function renderDialog(open: boolean, editApp?: EditAppData) {
      if (!dialogRoot) return;
      render(h(AddAppDialog, {
        isOpen: open,
        onClose: () => renderDialog(false),
        onSaved: () => { renderDialog(false); location.reload(); },
        ...(editApp ? { editApp } : {}),
      }), dialogRoot);
    }
    addButton?.addEventListener('click', () => renderDialog(true));
    document.addEventListener('click', (event) => {
      const editButton = (event.target as HTMLElement).closest('.edit-btn') as HTMLElement | null;
      if (!editButton?.dataset.editApp) return;
      try { renderDialog(true, JSON.parse(editButton.dataset.editApp) as EditAppData); } catch { /* invalid data */ }
    });
  </script>
)}
