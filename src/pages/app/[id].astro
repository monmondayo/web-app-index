---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import LibrarySidebar from '../../components/LibrarySidebar.astro';
import { getAppById, getApps } from '../../lib/db';
import { getCurrentUser } from '../../lib/auth';
import { APP_CATEGORIES, APP_STATUSES, getTechRole, type AppCategory, type AppStatus } from '../../lib/catalog';
import { TECH_DESCRIPTIONS, getTechIconSvg } from '../../lib/icons';

const user = await getCurrentUser(Astro.request, env.JWT_SECRET);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const id = Number(Astro.params.id);
const [app, allApps] = await Promise.all([
  getAppById(env.DB, id, user?.userId),
  getApps(env.DB, user?.userId),
]);
if (!app) return Astro.redirect('/');

const category = APP_CATEGORIES[app.category] || APP_CATEGORIES.other;
const status = APP_STATUSES[app.status] || APP_STATUSES.live;
const categoryCounts = Object.fromEntries(Object.keys(APP_CATEGORIES).map((key) => [key, allApps.filter((item) => item.category === key).length])) as Record<AppCategory, number>;
const statusCounts = Object.fromEntries(Object.keys(APP_STATUSES).map((key) => [key, allApps.filter((item) => item.status === key).length])) as Record<AppStatus, number>;
const thumbnailUrl = app.thumbnail_type === 'none' ? '' : app.thumbnail_url || (app.site_url ? `https://image.thum.io/get/width/1200/crop/675/${app.site_url}` : '');
const currentIndex = allApps.findIndex((item) => item.id === app.id);
const previousApp = currentIndex > 0 ? allApps[currentIndex - 1] : null;
const nextApp = currentIndex >= 0 && currentIndex < allApps.length - 1 ? allApps[currentIndex + 1] : null;
const previousUrl = previousApp ? `/app/${previousApp.id}` : '';
const nextUrl = nextApp ? `/app/${nextApp.id}` : '';
---
<Layout title={`${app.title} - App Library`}>
  <div class="min-h-screen lg:flex bg-slate-100">
    <LibrarySidebar user={user} active="apps" activeCategory={app.category} totalApps={allApps.length} categoryCounts={categoryCounts} statusCounts={statusCounts} />
    <div class="min-w-0 flex-1">
      <header class="library-topbar">
        <a href={`/?category=${app.category}`} class="inline-flex items-center gap-2 text-xs font-medium text-slate-500 hover:text-violet-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg>
          {category.label}へ戻る
        </a>
        <nav class="detail-step-nav" aria-label="アプリ紹介ナビゲーション">
          {previousApp ? (
            <a href={previousUrl} rel="prev" class="detail-step-link" aria-label={`前のアプリ：${previousApp.title}`} title={`前へ：${previousApp.title}`}>
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg>
            </a>
          ) : (
            <span class="detail-step-link is-disabled" aria-hidden="true"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg></span>
          )}
          <span class="detail-step-count">{currentIndex + 1} / {allApps.length}</span>
          {nextApp ? (
            <a href={nextUrl} rel="next" class="detail-step-link" aria-label={`次のアプリ：${nextApp.title}`} title={`次へ：${nextApp.title}`}>
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg>
            </a>
          ) : (
            <span class="detail-step-link is-disabled" aria-hidden="true"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></span>
          )}
        </nav>
      </header>

      <main
        id="app-detail"
        class="px-4 sm:px-6 lg:px-10 py-7 lg:py-10 max-w-6xl mx-auto"
        data-previous-url={previousUrl}
        data-next-url={nextUrl}
      >
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class:list={['category-accent', `category-accent-${category.accent}`]}></span>
          <span class="text-xs font-medium text-slate-500">{category.label}</span>
          <span class:list={['status-label', `status-${app.status}`, 'ml-2']}><span></span>{status.label}</span>
          {!!app.is_private && <span class="private-label">{app.is_locked ? 'Private・概要公開' : 'Private'}</span>}
        </div>

        <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,.65fr)] gap-6">
          <section class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm">
            {thumbnailUrl ? (
              <div class="aspect-video bg-slate-200 overflow-hidden"><img src={thumbnailUrl} alt={app.title} class="w-full h-full object-cover" /></div>
            ) : (
              <div class:list={['aspect-video flex items-center justify-center text-7xl font-semibold text-white bg-gradient-to-br', `app-thumbnail-${category.accent}`]}>{app.title.charAt(0)}</div>
            )}
            <div class="p-6 sm:p-8">
              <p class="eyebrow mb-3">Product</p>
              <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-slate-950">{app.title}</h1>
              <p class="mt-4 text-sm sm:text-base leading-7 text-slate-600">{app.description || '説明はまだ登録されていません。'}</p>
              <div class="mt-7 flex flex-wrap gap-3">
                {app.site_url && <a href={app.site_url} target="_blank" rel="noopener noreferrer" class="primary-button">サイトを開く ↗</a>}
                {app.github_url && <a href={app.github_url} target="_blank" rel="noopener noreferrer" class="secondary-button">GitHub ↗</a>}
              </div>
              {app.is_locked && (
                <div class="private-access-note">
                  <span class="private-access-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 10V8a5 5 0 0110 0v2m-9 0h8a2 2 0 012 2v7H6v-7a2 2 0 012-2z" /></svg>
                  </span>
                  <span class="min-w-0 flex-1">
                    <strong>Privateアプリの概要を公開中</strong>
                    <small>サイトとGitHubへのリンクは、所有者としてログインすると表示されます。技術構成はこのまま閲覧できます。</small>
                  </span>
                  <a href="/api/auth/login" class="secondary-button">ログイン</a>
                </div>
              )}
            </div>
          </section>

          <aside class="space-y-4">
            <div class="bg-slate-950 text-white rounded-3xl p-6 shadow-xl shadow-slate-300">
              <p class="text-[10px] font-semibold uppercase tracking-[.18em] text-violet-300">Architecture</p>
              <h2 class="mt-2 text-lg font-semibold">技術構成</h2>
              <p class="mt-2 text-xs leading-5 text-slate-400">技術名だけでなく、このアプリで担当している役割を表示します。</p>
              <div class="mt-6 space-y-3">
                {app.tech_stacks.length ? app.tech_stacks.map((tech, index) => (
                  <div class="relative flex items-start gap-3 pb-3 last:pb-0">
                    {index < app.tech_stacks.length - 1 && <span class="absolute left-[17px] top-9 bottom-0 w-px bg-slate-700"></span>}
                    <span class="relative z-10 w-9 h-9 rounded-xl bg-white flex items-center justify-center flex-shrink-0"><img src={getTechIconSvg(tech.slug, tech.color)} alt="" class="w-5 h-5" /></span>
                    <span class="min-w-0 pt-0.5">
                      <strong class="block text-xs font-semibold">{tech.name}</strong>
                      <span class="block mt-0.5 text-[10px] text-violet-300">{getTechRole(tech.category, tech.usage_role)}</span>
                    </span>
                  </div>
                )) : <p class="text-xs text-slate-500">技術スタックは未登録です。</p>}
              </div>
            </div>
          </aside>
        </div>

        {app.tech_stacks.length > 0 && (
          <section class="mt-8">
            <div class="mb-4">
              <p class="eyebrow mb-2">Technology notes</p>
              <h2 class="text-xl font-semibold text-slate-900">それぞれの技術について</h2>
            </div>
            <div class="tech-role-grid">
              {app.tech_stacks.map((tech) => (
                <div class="tech-role-item !p-4">
                  <span class="tech-role-icon"><img src={getTechIconSvg(tech.slug, tech.color)} alt="" /></span>
                  <span class="min-w-0">
                    <strong>{tech.name}</strong>
                    <span class="tech-role-name">{getTechRole(tech.category, tech.usage_role)}</span>
                    <span class="tech-role-description !line-clamp-none">{TECH_DESCRIPTIONS[tech.name] || 'このアプリを構成する技術のひとつです。'}</span>
                  </span>
                </div>
              ))}
            </div>
          </section>
        )}

        <nav class="detail-sequence" aria-label="前後のアプリ">
          {previousApp ? (
            <a href={previousUrl} rel="prev" class="detail-sequence-link">
              <span class="detail-sequence-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 18-6-6 6-6" /></svg></span>
              <span class="detail-sequence-copy"><small>Previous app</small><strong>{previousApp.title}</strong></span>
            </a>
          ) : (
            <span class="detail-sequence-link is-disabled"><span class="detail-sequence-icon">—</span><span class="detail-sequence-copy"><small>Previous app</small><strong>最初のアプリです</strong></span></span>
          )}
          {nextApp ? (
            <a href={nextUrl} rel="next" class="detail-sequence-link is-next">
              <span class="detail-sequence-copy"><small>Next app</small><strong>{nextApp.title}</strong></span>
              <span class="detail-sequence-icon"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" /></svg></span>
            </a>
          ) : (
            <span class="detail-sequence-link is-disabled is-next"><span class="detail-sequence-copy"><small>Next app</small><strong>最後のアプリです</strong></span><span class="detail-sequence-icon">—</span></span>
          )}
        </nav>
      </main>
    </div>
  </div>
</Layout>

<script>
  const detail = document.getElementById('app-detail');
  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.matches('input, textarea, select, [contenteditable="true"]')) return;
    const destination = event.key === 'ArrowLeft'
      ? detail?.dataset.previousUrl
      : event.key === 'ArrowRight'
        ? detail?.dataset.nextUrl
        : '';
    if (destination) location.href = destination;
  });
</script>
