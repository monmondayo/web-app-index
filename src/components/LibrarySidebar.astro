---
import type { JWTPayload } from '../lib/auth';
import { APP_CATEGORIES, APP_STATUSES, type AppCategory, type AppStatus } from '../lib/catalog';

interface Props {
  user: JWTPayload | null;
  active?: 'overview' | 'apps' | 'tech';
  activeCategory?: AppCategory | 'all';
  activeStatus?: AppStatus | 'all';
  totalApps?: number;
  categoryCounts?: Partial<Record<AppCategory, number>>;
  statusCounts?: Partial<Record<AppStatus, number>>;
}

const {
  user,
  active = 'apps',
  activeCategory = 'all',
  activeStatus = 'all',
  totalApps = 0,
  categoryCounts = {},
  statusCounts = {},
} = Astro.props;
---
<aside class="library-sidebar lg:sticky lg:top-0 lg:h-screen lg:w-64 lg:flex-shrink-0 bg-slate-950 text-slate-200 border-b lg:border-b-0 lg:border-r border-slate-800">
  <div class="h-full flex lg:flex-col p-3 lg:p-5 gap-3 lg:gap-0 overflow-x-auto lg:overflow-visible">
    <a href="/" class="flex items-center gap-3 px-2 py-1 flex-shrink-0 group">
      <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-950/40 group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6.5A2.5 2.5 0 016.5 4H9v5H4V6.5zM15 4h2.5A2.5 2.5 0 0120 6.5V9h-5V4zM4 15h5v5H6.5A2.5 2.5 0 014 17.5V15zM15 15h5v2.5a2.5 2.5 0 01-2.5 2.5H15v-5z" />
        </svg>
      </span>
      <span class="hidden lg:block">
        <span class="block text-sm font-semibold text-white tracking-tight">App Library</span>
        <span class="block text-[10px] uppercase tracking-[0.18em] text-slate-500 mt-0.5">Monmon Works</span>
      </span>
    </a>

    <nav class="flex lg:block gap-1 lg:mt-8 flex-shrink-0" aria-label="メインメニュー">
      <p class="hidden lg:block px-3 mb-2 text-[10px] uppercase tracking-[0.16em] text-slate-600">Library</p>
      <a href="/" class:list={['sidebar-link', active === 'apps' && activeCategory === 'all' && activeStatus === 'all' && 'is-active']}>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <span>すべて</span><span class="sidebar-count">{totalApps}</span>
      </a>
    </nav>

    <nav class="hidden lg:block mt-7" aria-label="アプリカテゴリー">
      <p class="px-3 mb-2 text-[10px] uppercase tracking-[0.16em] text-slate-600">Categories</p>
      <div class="space-y-0.5">
        {Object.entries(APP_CATEGORIES).map(([key, item]) => (
          <a href={`/?category=${key}`} class:list={['sidebar-link', active === 'apps' && activeCategory === key && 'is-active']}>
            <span class:list={['category-dot', `category-dot-${item.accent}`]}></span>
            <span>{item.label}</span><span class="sidebar-count">{categoryCounts[key as AppCategory] || 0}</span>
          </a>
        ))}
      </div>
    </nav>

    <nav class="hidden lg:block mt-7" aria-label="公開状態">
      <p class="px-3 mb-2 text-[10px] uppercase tracking-[0.16em] text-slate-600">Status</p>
      <div class="space-y-0.5">
        {Object.entries(APP_STATUSES).map(([key, item]) => (
          <a href={`/?status=${key}`} class:list={['sidebar-link', active === 'apps' && activeStatus === key && 'is-active']}>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="1.8" /></svg>
            <span>{item.label}</span><span class="sidebar-count">{statusCounts[key as AppStatus] || 0}</span>
          </a>
        ))}
      </div>
    </nav>

    <nav class="flex lg:block gap-1 lg:mt-7 flex-shrink-0" aria-label="技術メニュー">
      <p class="hidden lg:block px-3 mb-2 text-[10px] uppercase tracking-[0.16em] text-slate-600">Explore</p>
      <a href="/tech" class:list={['sidebar-link', active === 'tech' && 'is-active']}>
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V4H6.5A2.5 2.5 0 004 6.5v13z" /></svg>
        <span>技術カタログ</span>
      </a>
    </nav>

    <div class="lg:hidden ml-auto flex items-center flex-shrink-0">
      {user ? (
        <a href="/api/auth/logout" aria-label="ログアウト" class="w-9 h-9 rounded-full ring-2 ring-slate-800 overflow-hidden">
          <img src={user.avatarUrl || ''} alt="" class="w-full h-full object-cover" />
        </a>
      ) : (
        <a href="/api/auth/login" class="px-3 py-2 rounded-lg text-xs text-slate-300 bg-slate-900">ログイン</a>
      )}
    </div>

    <div class="hidden lg:block mt-auto pt-5 border-t border-slate-800">
      {user ? (
        <div class="flex items-center gap-3 px-2">
          <img src={user.avatarUrl || ''} alt="" class="w-9 h-9 rounded-full ring-2 ring-slate-800" />
          <div class="min-w-0 flex-1">
            <p class="text-xs text-white truncate">{user.githubUsername}</p>
            <a href="/api/auth/logout" class="text-[10px] text-slate-500 hover:text-slate-300">ログアウト</a>
          </div>
        </div>
      ) : (
        <a href="/api/auth/login" class="sidebar-link">
          <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 00-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.57-.3-5.27-1.29-5.27-5.72 0-1.27.45-2.3 1.19-3.11-.12-.3-.52-1.48.11-3.07 0 0 .98-.31 3.19 1.19a11.1 11.1 0 015.82 0c2.21-1.5 3.18-1.19 3.18-1.19.63 1.6.23 2.78.11 3.07.75.81 1.19 1.84 1.19 3.11 0 4.45-2.71 5.42-5.29 5.71.42.36.79 1.07.79 2.15v3.17c0 .31.21.67.8.56A11.5 11.5 0 0012 .7z" /></svg>
          <span>GitHubでログイン</span>
        </a>
      )}
    </div>
  </div>
</aside>
