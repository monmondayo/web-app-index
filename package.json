{
  "name": "web-app-index",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro",
    "db:init": "wrangler d1 execute web-app-index-db --local --file=schema.sql",
    "db:migrate:private": "wrangler d1 execute web-app-index-db --local --file=migrations/0001_private_apps.sql",
    "db:migrate:library": "wrangler d1 execute web-app-index-db --local --file=migrations/0002_library_navigation.sql",
    "db:seed": "wrangler d1 execute web-app-index-db --local --file=seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/preact": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "preact": "^10.29.8",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0"
  }
}
